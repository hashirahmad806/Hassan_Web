# ==========================================================
# Dr. Hassan Web — Comprehensive Git Ignore Policy
# ==========================================================

# ── Dependencies ──────────────────────────────────────────
node_modules/
jspm_packages/
.npm
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ── Sanity Studio ─────────────────────────────────────────
.sanity/
studio/.sanity/
studio/dist/

# ── Build Outputs ─────────────────────────────────────────
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.turbo/
.parcel-cache/

# ── Vite & Framework Caches ───────────────────────────────
.vite/
*.local
.boneyard/
bones_cache/

# ── Logs & Debugging ──────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
node_report.csv
v8.out
*.seed
*.pid
*.heapsnapshot

# ── Environment & Secrets ─────────────────────────────────
# Never commit real credentials or secret keys
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
studio/.env
studio/.env.*
*.pem
*.key
*.cert
# Allow committed template examples
!*.env.example

# ── Testing & Coverage ────────────────────────────────────
coverage/
.nyc_output/
*.timestamp-*

# ── OS Generated Files ────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDEs and Editors ──────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/

# ── Temporary & Scratch Files ─────────────────────────────
*.tmp
*.temp
.tmp/

# ── Heavy Design Archive Bundles ──────────────────────────
*.zip
*.tar.gz
*.rar

# ── AI IDE / Agent Runtime Storage ────────────────────────
.gemini/
